# Copy to .env.local for local development, or set these in your
# hosting provider's environment variable settings for production.

# --- Contact delivery (apps/marketing/src/app/api/contact/route.ts) ---
# Gmail SMTP via nodemailer, sending to/from axiomaflow@gmail.com.
# GMAIL_USER=axiomaflow@gmail.com
#
# GMAIL_APP_PASSWORD is NOT the regular Gmail password — Google
# requires 2-Step Verification to be enabled on the account, then an
# "App Password" generated specifically for this:
#   Google Account → Security → 2-Step Verification → App passwords
#   → choose "Mail" → generate → paste the 16-character result below.
# Without both variables set, POST /api/contact validates submissions
# correctly but honestly responds 503 ("not configured yet") instead
# of faking a successful delivery.
GMAIL_USER=axiomaflow@gmail.com
GMAIL_APP_PASSWORD=
